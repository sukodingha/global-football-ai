rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole(request.auth.uid) in ['admin', 'superAdmin'];
    }

    function isModerator() {
      return isSignedIn() && getUserRole(request.auth.uid) in ['moderator', 'admin', 'superAdmin'];
    }

    // ─── Users profile ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Community wall ──────────────────────────────────────────────
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() &&
        (request.resource.data.authorId == request.auth.uid || isModerator());
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isOwner(resource.data.authorId) || isModerator();
        allow delete: if isOwner(resource.data.authorId) || isModerator();
      }

      match /likes/{likeId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == likeId;
      }
    }

    // ─── Fantasy Football ────────────────────────────────────────────
    match /fantasy_leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    match /fantasy_teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /fantasy_players/{playerId} {
      // Player pool is populated by trusted sources; read-only for users.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fantasy_leaderboards/{boardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /entries/{entryId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /fantasy_scoring_events/{eventId} {
      // Scoring events are generated by the automated scoring engine
      // (admin/trusted worker). Read-only for users.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Admin collections ───────────────────────────────────────────
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admin_predictions/{predictionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

// ─── Moderation logs ─────────────────────────────────────────────
    // Centralized moderation log: flagged posts, banned users, reported
    // content. Readable/writable by moderators and admins.
    match /moderation_logs/{logId} {
      allow read, write: if isModerator();
    }

    // ─── Payments / subscriptions ────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Notifications ───────────────────────────────────────────────
    match /notification_preferences/{prefId} {
      allow read, update: if isOwner(prefId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── Settings ────────────────────────────────────────────────────
    match /user_settings/{settingId} {
      allow read, update: if isOwner(settingId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── Admin managed competitions ──────────────────────────────────
    match /competitions/{competitionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Default deny ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
